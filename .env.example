# =============================================================================
# Variables del stack Aprentix.
#
# Mismo fichero, mismos nombres para cualquier entorno (dev, desa,
# prod).  Sólo cambian los valores. Ninguna variable lleva el sufijo
# del entorno — el "dónde" lo aportan DOMINIO_WEB, DOMINIO_API y
# DB_NAME.
# =============================================================================

# ── Postgres / auth ────────────────────────────────────────────────────────
DB_NAME=aprentix_desa
DB_PASS=cambia_esto
AUTH_PASS=cambia_esto_para_postgrest
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
ADMIN_PASS=cambia_esto_min_8

# ── Dominios servidos por Traefik ──────────────────────────────────────────
DOMINIO_WEB=desa.aprentix.es
DOMINIO_API=api.desa.aprentix.es

# ── SMTP (envío del correo de verificación de cuenta) ──────────────────────
# Gmail necesita "contraseña de aplicación" (no la de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls
MAILER_TICK=30
MAILER_BATCH=25
MAILER_LOG=INFO

# ── Web Push (VAPID) ───────────────────────────────────────────────────────
# Genera un par con:
#   docker run --rm -v $PWD/notificador:/w -w /w python:3.12-slim \
#     sh -c 'pip install py-vapid && python gen_vapid.py'
# Guarda también la pública en la BBDD:
#   UPDATE config SET valor = '"<clave_publica>"'::jsonb
#     WHERE clave = 'push_vapid_public';
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:soporte@aprentix.es
NOTIF_TICK=60
NOTIF_BATCH=50
NOTIF_LOG=INFO
