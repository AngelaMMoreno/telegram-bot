# =============================================================================
# Superset con TODAS las variables del stack.  Sirve para dev local
# (`docker compose up` en el raíz usa este fichero).
#
# En Dokploy NO se usa este fichero: cada Compose Application tiene
# el suyo. Ver `deploy/<stack>/.env.example` para la lista exacta.
#
# Los NOMBRES de variable son los mismos en cualquier entorno.  Sólo
# cambian los VALORES.  Para que desa y prod convivan sobre el mismo
# host Dokploy se usa STACK_SUFFIX (ver DESPLIEGUE.md).
# =============================================================================

# ── Coexistencia desa/prod ────────────────────────────────────────────────
# Vacío   → containers y aliases neutros (`db`, `postgrest`, `app`, ...)
# `-desa` → containers y aliases con sufijo (`db-desa`, ...)
STACK_SUFFIX=

# ── Postgres / auth ───────────────────────────────────────────────────────
DB_NAME=aprentix
DB_PASS=cambia_esto
AUTH_PASS=cambia_esto_para_postgrest
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
ADMIN_PASS=cambia_esto_min_8

# ── Dominios servidos por Traefik ─────────────────────────────────────────
DOMINIO_WEB=aprentix.local
DOMINIO_API=api.aprentix.local

# ── SMTP (envío del correo de verificación de cuenta) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls
MAILER_TICK=30
MAILER_BATCH=25
MAILER_LOG=INFO

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:soporte@aprentix.es
NOTIF_TICK=60
NOTIF_BATCH=50
NOTIF_LOG=INFO
