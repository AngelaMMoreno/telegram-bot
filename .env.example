# ─────────────────────────────────────────────────────────────────────────────
# Superset con TODAS las variables del proyecto. Sirve para:
#   - `docker compose up` en desarrollo local (docker-compose.yml raíz).
#   - Como referencia global de las variables por si buscas alguna.
#
# En Dokploy NO se usa este fichero: cada Compose Application tiene sus
# propias variables. Ver deploy/<stack>/.env.example para la lista exacta
# que necesita cada stack (core, app, notificador, backups).
# ─────────────────────────────────────────────────────────────────────────────

# ── BD (nombre y owner configurables por entorno) ──────────────────────────
# Producción usa 'aprentix'. En la rama de rediseño → aprentix_desa.
#POSTGRES_DB=aprentix
#POSTGRES_USER=aprentix

# ── Secretos compartidos ────────────────────────────────────────────────────
DB_PASS=cambia_esto
AUTH_PASS=cambia_esto_para_postgrest
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
ADMIN_PASS=cambia_esto_minimo_10

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=tu@correo.es
PGADMIN_PASS=cambia_esto

# ── Dominios servidos por Traefik ───────────────────────────────────────────
# DOMINIO_LANDING es OBLIGATORIO: es el host de la SPA para ESTE despliegue.
# Producción usa aprentix.es; la rama de desarrollo se despliega en un host
# separado (p.ej. desa.aprentix.es) para poder coexistir con el prod sin
# pisarse. Da de alta el A record en tu proveedor de DNS apuntando al VPS.
DOMINIO_LANDING=aprentix.es
# Alias opcional. Si lo dejas en blanco, cae al mismo valor de DOMINIO_LANDING
# (regla duplicada e inofensiva).
DOMINIO_LANDING_ALT=www.aprentix.es
# Redirecciones de dominios legados → DOMINIO_LANDING. OPCIONALES: si los
# dejas comentados, se sustituyen por hosts `.invalid` inertes, ideales para
# despliegues de dev/preview que no quieren pisar los .aprentix.es del prod.
#DOMINIO_WEB=test.aprentix.es
#DOMINIO_WEB_ALT=www.test.aprentix.es
#DOMINIO_TEORIA=teoria.aprentix.es
#DOMINIO_TEORIA_ALT=www.teoria.aprentix.es
DOMINIO_API=api.aprentix.es
DOMINIO_PGADMIN=pgadmin.aprentix.es

# ── Backups automáticos a Google Drive (stack 'backups') ────────────────────
# rclone.conf con el token OAuth de Drive va en /mnt/data/backup-config/.
# Ver deploy/backups/README.md para el paso a paso de rclone config.
RESTIC_REPOSITORY=rclone:gdrive:aprentix-backups
RESTIC_PASSWORD=cambia_esto_por_algo_largo_y_aleatorio
RESTIC_HOST=aprentix
KEEP_LAST=2
BACKUP_CRON=30 3 * * *
TZ=Europe/Madrid

# ── Notificaciones Web Push (stack 'notificador') ───────────────────────────
# Genera el par con:  python notificador/gen_vapid.py
# La PUBLIC también debe guardarse en config.push_vapid_public (la SPA la
# lee por RPC push_config_publica); si no, la SPA se niega a suscribir.
#
# La PRIVATE puede ir en 3 formatos: PEM con \n literales (recomendado para
# .env), base64 del PEM entero, o PEM multilínea real. El worker autodetecta.
VAPID_PRIVATE_KEY=pega_aqui_la_pem_con_saltos_como_\n
VAPID_PUBLIC_KEY=pega_aqui_la_base64url
VAPID_SUBJECT=mailto:soporte@aprentix.es
TICK_SECONDS=300
BATCH_LIMIT=500

# ── SMTP (stack 'core', servicio 'mailer') ─────────────────────────────────
# El mailer envía verificación de email y reset de contraseña. Con
# MAILER_DEV_LOG_ONLY=1 se saltan los envíos y se imprimen en logs — útil
# en desarrollo local mientras no tienes cuenta SMTP.
MAILER_DEV_LOG_ONLY=0
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=hola@aprentix.es
SMTP_PASS=cambia_esto
SMTP_FROM=Aprentix <hola@aprentix.es>
SMTP_TLS=starttls
