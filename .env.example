# =============================================================================
# Superset con TODAS las variables del stack (dev local con
# `docker compose up` en el raíz).
#
# En Dokploy NO se usa este fichero: cada Compose Application tiene
# el suyo (ver `deploy/<stack>/.env.example`).
#
# Los NOMBRES de variable son los mismos en cualquier entorno. Sólo
# cambian los VALORES.  Para que desa y prod convivan en el mismo
# host se usa DB_ALIAS (ver DESPLIEGUE.md).
# =============================================================================

# --- Distintivo del entorno (coexistencia prod + desa) ---
# Valores típicos: prod | desa
# → containers y aliases en dokploy-network: db-prod, postgrest-prod, ...
DB_ALIAS=desa

# --- PostgreSQL ---
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=
AUTH_PASS=
ADMIN_PASS=

# --- JWT (mismo valor en Postgres, PostgREST y en el resto de stacks) ---
JWT_SECRET=

# --- Traefik ---
DOMINIO_LANDING=desa.aprentix.es
DOMINIO_LANDING_ALT=www.desa.aprentix.es
DOMINIO_API=api.desa.aprentix.es

# --- pgAdmin (SOLO en prod; en desa deja COMPOSE_PROFILES vacío) ---
COMPOSE_PROFILES=
PGADMIN_EMAIL=cccoboss12@gmail.com
PGADMIN_PASS=
DOMINIO_PGADMIN=pgadmin.aprentix.es

# --- SMTP (mailer) ---
MAILER_DEV_LOG_ONLY=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls

# --- Web Push (notificador) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:cccoboss12@gmail.com

# --- Compartido por mailer y notificador ---
TICK_SECONDS=300
BATCH_LIMIT=500
LOG_LEVEL=INFO

# --- Backups (restic + rclone → Google Drive) ---
RESTIC_REPOSITORY=rclone:gdrive:aprentix_desa-backups
RESTIC_PASSWORD=
RESTIC_HOST=aprentix
KEEP_LAST=2
BACKUP_CRON=30 3 * * *
TZ=Europe/Madrid
