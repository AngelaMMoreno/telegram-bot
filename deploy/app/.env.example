# Variables del stack APP (contenedor único: Caddy + SPA rediseñada
# /estudio/ + backend FastAPI de contenidos).
# Copiar a la Compose Application 'app' de Dokploy.

# ── JWT ─────────────────────────────────────────────────────────────────────
# EXACTAMENTE el mismo secreto que en el stack core: el backend de contenidos
# valida los JWT emitidos por Postgres/PostgREST.
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios

# ── Dominios servidos por Traefik ──────────────────────────────────────────
# aprentix.es sirve la única SPA (/estudio/) y su raíz redirige allí.
# Los hosts *.aprentix.es de la etapa multi-SPA (test.*, teoria.*) se
# conservan sólo como redirecciones permanentes a aprentix.es/estudio/
# para no romper bookmarks antiguos.
DOMINIO_LANDING=aprentix.es
DOMINIO_LANDING_ALT=www.aprentix.es
DOMINIO_WEB=test.aprentix.es
DOMINIO_WEB_ALT=www.test.aprentix.es
DOMINIO_TEORIA=teoria.aprentix.es
DOMINIO_TEORIA_ALT=www.teoria.aprentix.es
