# Variables del stack APP (contenedor único: Caddy + landing + tests
# + teoria + estudio + backend FastAPI de teoría/contenido).
# Copiar a la Compose Application 'app' de Dokploy.

# ── JWT ─────────────────────────────────────────────────────────────────────
# EXACTAMENTE el mismo secreto que en el stack core: el backend de teoría
# valida los JWT emitidos por Postgres/PostgREST.
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios

# ── Dominios servidos por Traefik ──────────────────────────────────────────
# aprentix.es sirve la landing en /, la SPA de tests en /tests/, la de
# teoría en /teoria/ y la nueva SPA de estudio en /estudio/. Los alt-hosts
# quedan como legacy y redirigen a la landing (permanent redirect).
DOMINIO_LANDING=aprentix.es
DOMINIO_LANDING_ALT=www.aprentix.es
DOMINIO_WEB=test.aprentix.es
DOMINIO_WEB_ALT=www.test.aprentix.es
DOMINIO_TEORIA=teoria.aprentix.es
DOMINIO_TEORIA_ALT=www.teoria.aprentix.es
