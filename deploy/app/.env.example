# =============================================================================
# Variables del stack APP (Caddy + SPA).
# =============================================================================

# El MISMO valor que en el .env del stack core del mismo entorno
# (para que la SPA proxye al `postgrest` o `postgrest-desa` correcto).
DB_ALIAS=desa

# La SPA no los usa directamente hoy, pero se mantienen los nombres
# para uniformidad con el .env de core.
POSTGRES_DB=aprentix_desa
JWT_SECRET=

# Traefik: dominio principal y (opcional) alt (típicamente el `www.`).
DOMINIO_LANDING=desa.aprentix.es
DOMINIO_LANDING_ALT=www.desa.aprentix.es
