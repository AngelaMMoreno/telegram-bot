# Gateway público de Aprentix. Sirve la aplicación remodelada en /estudio,
# conserva redirecciones desde las rutas antiguas y reenvía la API de
# contenidos a uvicorn.
#
# Traefik termina TLS y nos pasa HTTP por :80.

:80 {
    encode zstd gzip

    # ── Service worker en la raíz (scope "/") ─────────────────────────
    # Debe servirse desde el path exacto en el que se registra
    # (aprentix.es/service-worker.js).  Este bloque va ANTES de los
    # `handle` genéricos para que las cabeceras se apliquen tal cual
    # con cabeceras equivocadas.
    @sw path /service-worker.js
    header @sw Cache-Control "no-cache"
    header @sw Service-Worker-Allowed "/"

    # Sin barra final los prefijos no matchean; redirigimos para que el
    # <base href> de cada SPA resuelva correctamente los assets.
    @estudio_no_slash path /estudio
    redir @estudio_no_slash /estudio/ 301

    # ── Assets compartidos ───────────────────────────────────────────
    handle_path /shared/* {
        root * /srv/shared
        file_server
    }

    # ── API de contenidos (uvicorn interno, :8000) ───────────────────
    handle /teoria/api/* {
        uri strip_prefix /teoria
        reverse_proxy 127.0.0.1:8000
    }

    # ── SPA (rediseño). Sirve estáticos desde /srv/estudio. La SPA hace
    # sus RPCs contra /api/rpc/… (ruta absoluta) y las rutas privadas se
    # encaminan por hash (#/…), así que basta con servir index.html.
    handle_path /estudio/* {
        root * /srv/estudio
        try_files {path} /index.html
        file_server
    }

    # ── API PostgREST ─────────────────────────────────────────────────
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest:3000
    }

    # MIME correcto para el manifest PWA.
    @manifest path *.webmanifest
    header @manifest Content-Type application/manifest+json

    handle /manifest.webmanifest {
        root * /srv
        file_server
    }

    handle /service-worker.js {
        root * /srv
        file_server
    }

    # WAOA: legacy, servido con Content-Type JSON por si algún cliente
    # instalado antiguo lo pide.
    @waoa path /.well-known/web-app-origin-association
    header @waoa Content-Type application/json
    header @waoa Access-Control-Allow-Origin *

    # Rutas legadas que ya no existen como apps propias: /tests y /teoria
    # ahora viven dentro de la SPA remodelada. Redirigimos a la raíz para
    # que el usuario aterrice en la pantalla de login (o el home si ya
    # tiene sesión) en vez de en URLs muertas.
    handle /tests/* {
        redir * / 308
    }
    handle /teoria/* {
        redir * / 308
    }

    # ── Raíz: sirve la SPA directamente, sin redirección. Antes
    # aprentix.es → /estudio/, lo que confundía al usuario que sólo
    # quería entrar en su cuenta. Ahora, si no hay sesión, la SPA
    # muestra la pantalla de login solarpunk; si ya la hay, va al home.
    handle {
        root * /srv/estudio
        try_files {path} /index.html
        file_server
    }
}
