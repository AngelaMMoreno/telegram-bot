# Gateway público del frontend.  Traefik termina TLS y entrega HTTP
# por :80.  La misma imagen sirve para dev, desa y prod: el hostname
# del PostgREST al que proxyar se lee de la variable de entorno
# POSTGREST_UPSTREAM (por defecto `postgrest:3000`).

:80 {
    encode zstd gzip

    # ── API pública ──
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy {$POSTGREST_UPSTREAM}
    }

    # ── SPA (raíz) ──
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
