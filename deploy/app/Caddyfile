# Gateway público de Aprentix. Sirve la aplicación remodelada en /estudio,
# conserva redirecciones desde las rutas antiguas y reenvía la API de
# contenidos a uvicorn.
#
# Traefik termina TLS y nos pasa HTTP por :80.

:80 {
    encode zstd gzip

    # ── Service worker en la raíz (scope "/") ─────────────────────────
    # Debe servirse desde el path exacto en el que se registra
    # (aprentix.es/service-worker.js).  Este bloque va ANTES de los
    # `handle` genéricos para que las cabeceras se apliquen tal cual
    # con cabeceras equivocadas.
    @sw path /service-worker.js
    header @sw Cache-Control "no-cache"
    header @sw Service-Worker-Allowed "/"

    # Sin barra final los prefijos no matchean; redirigimos para que el
    # <base href> de cada SPA resuelva correctamente los assets.
    @estudio_no_slash path /estudio
    redir @estudio_no_slash /estudio/ 301

    # ── Assets compartidos ───────────────────────────────────────────
    handle_path /shared/* {
        root * /srv/shared
        file_server
    }

    # ── API de contenidos (uvicorn interno, :8000) ───────────────────
    handle /teoria/api/* {
        uri strip_prefix /teoria
        reverse_proxy 127.0.0.1:8000
    }

    # ── SPA nueva /estudio (rediseño). Usa <base href="/estudio/"> y hace
    # sus RPCs contra /api/rpc/… (ruta absoluta), así que aquí sólo hay
    # que servir estáticos. No necesita handle_path /estudio/api/* porque
    # el fetch va directo a /api/*.
    handle_path /estudio/* {
        root * /srv/estudio
        try_files {path} /index.html
        file_server
    }

    # ── API PostgREST ─────────────────────────────────────────────────
    handle /api/* {
        uri strip_prefix /api
        # DESA: apunta al postgrest del stack core de esta rama, que se
        # llama `postgrest_desa` para evitar colisión de alias DNS con
        # el `postgrest` del stack core de producción en dokploy-network.
        reverse_proxy postgrest_desa:3000
    }

    # MIME correcto para el manifest PWA.
    @manifest path *.webmanifest
    header @manifest Content-Type application/manifest+json

    handle /manifest.webmanifest {
        root * /srv
        file_server
    }

    handle /service-worker.js {
        root * /srv
        file_server
    }

    # WAOA: legacy, servido con Content-Type JSON por si algún cliente
    # instalado antiguo lo pide.
    @waoa path /.well-known/web-app-origin-association
    header @waoa Content-Type application/json
    header @waoa Access-Control-Allow-Origin *

    # Compatibilidad con enlaces antiguos: /tests/* y /teoria/* redirigen
    # a la raíz (donde ahora vive la SPA), no a /estudio/, para no volver
    # a filtrar el prefijo interno en la barra de URL.
    #
    # Ojo: `redir <to> <code>` sin matcher no funciona aquí porque Caddy
    # interpreta el primer argumento con `/` inicial como *matcher* de path
    # y trata el 3xx como URL de destino → genera Location: "308", status
    # 302 y matcher inservible /estudio/. El `*` explícito consume la
    # posición del matcher y deja que 308 sea el código.
    handle /tests/* {
        redir * / 308
    }
    handle /teoria/* {
        redir * / 308
    }

    # ── App-first: la raíz sirve el index de la SPA sin redirigir ─────
    # Antes hacíamos `redir * /estudio/ 308`, que dejaba `aprentix.es/estudio/`
    # en la barra de URL — feo y descolocaba el modelo mental de la app.
    # Ahora servimos directamente el shell de la SPA desde el origin: el
    # <base href> ya no existe (index sin él), todos los assets se referencian
    # con paths absolutos (/shared/… /estudio/app.js) y el router hash
    # funciona idéntico desde cualquier ruta base.
    handle {
        root * /srv/estudio
        try_files {path} /index.html
        file_server
    }
}
