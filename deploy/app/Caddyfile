# Gateway público de aprentix.es (contenedor único, deploy/app/).
#
# Sirve la SPA nueva bajo /estudio/*, reenvía /api/* a PostgREST y los
# endpoints de contenido /teoria/api/* al backend FastAPI local (que
# entrega ficheros de teoría; ya no sirve ninguna SPA propia). La raíz `/`
# redirige a /estudio/ para que aprentix.es siga siendo un punto de
# entrada válido.
#
# Traefik termina TLS y nos pasa HTTP por :80.

:80 {
    encode zstd gzip

    # ── Service worker en la raíz (scope "/") ─────────────────────────
    # Debe servirse desde el path exacto en el que se registra
    # (aprentix.es/service-worker.js). Este bloque va ANTES de los
    # `handle` genéricos para no caer en el file_server con cabeceras
    # equivocadas.
    @sw path /service-worker.js
    header @sw Cache-Control "no-cache"
    header @sw Service-Worker-Allowed "/"

    # Sin barra final el prefijo no matchea; redirigimos para que el
    # <base href> de la SPA resuelva correctamente los assets.
    @estudio_no_slash path /estudio
    redir @estudio_no_slash /estudio/ 301

    # Raíz → SPA principal.
    @root path /
    redir @root /estudio/ 302

    # ── Assets compartidos: una sola copia física en /srv/shared ─────
    # La SPA los pide con /estudio/shared/* por su <base href>. Este
    # rewrite evita duplicar la carpeta shared en la imagen.
    handle_path /estudio/shared/* {
        root * /srv/shared
        file_server
    }

    # ── Backend de contenido (uvicorn interno, :8000) ─────────────────
    # Sólo exponemos su API. Ya no sirve ninguna SPA propia — la teoría
    # se lee desde /estudio con fetch a /teoria/api/leer?ruta=…
    # Quita el prefijo /teoria antes de reenviar: uvicorn sigue montado
    # en /api/*, igual que en el modo anterior.
    handle /teoria/api/* {
        uri strip_prefix /teoria
        reverse_proxy 127.0.0.1:8000
    }

    # ── SPA /estudio (estática) ──────────────────────────────────────
    handle_path /estudio/* {
        root * /srv/estudio
        try_files {path} /index.html
        file_server
    }

    # ── API PostgREST (login, mi_sesion, iniciar_intento_*, etc.) ────
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest:3000
    }

    # MIME correcto para el manifest PWA.
    @manifest path *.webmanifest
    header @manifest Content-Type application/manifest+json

    # WAOA: legacy, servido con Content-Type JSON por si algún cliente
    # instalado antiguo lo pide.
    @waoa path /.well-known/web-app-origin-association
    header @waoa Content-Type application/json
    header @waoa Access-Control-Allow-Origin *

    # ── Assets del origin (SW, manifest, iconos sueltos) ─────────────
    handle {
        root * /srv
        try_files {path} =404
        file_server
    }
}
