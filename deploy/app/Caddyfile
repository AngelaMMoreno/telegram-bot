# Gateway público del frontend.  Traefik termina TLS y entrega HTTP
# por :80.  Sirve la SPA como estáticos y proxya /api/* a PostgREST.

:80 {
    encode zstd gzip

    # ── API pública ──
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest:3000
    }

    # ── SPA (raíz) ──
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
