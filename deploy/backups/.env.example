# =============================================================================
# Variables del stack BACKUPS (snapshots restic + rclone).
#
# Mismos NOMBRES que en prod; sólo cambia el valor (POSTGRES_DB,
# DB_ALIAS y RESTIC_REPOSITORY apuntan a la carpeta correcta).
# =============================================================================

# --- Distintivo del entorno (mismo valor que en el resto de stacks) ---
# Vacío → hostname `db` (prod).  `desa` → hostname `db-desa`.
DB_ALIAS=desa

# --- BBDD origen (mismas credenciales que el stack core) ---
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=

# --- Repositorio restic ---
# rclone:<remote>:<carpeta>.  El remote (aquí `gdrive`) es el nombre
# que le diste al conectar Google Drive con `rclone config` local.
# Carpeta DIFERENTE de la de prod para no mezclar snapshots.
RESTIC_REPOSITORY=rclone:gdrive:aprentix_desa-backups

# Contraseña de cifrado del repo (32+ chars aleatorios).  SIN esta
# contraseña NADIE puede restaurar, ni tú — guárdala junto a la del
# stack core.
RESTIC_PASSWORD=

# Etiqueta lógica del host en cada snapshot.  Sirve para distinguir
# backups de varios entornos si acaban en el mismo repositorio.
RESTIC_HOST=aprentix

# --- Retención y horario ---
KEEP_LAST=2
BACKUP_CRON=30 3 * * *
TZ=Europe/Madrid
