# =============================================================================
# Variables para el entorno DESA (paralelo al de producción).
#
# Todas terminan en _DESA para no colisionar si compartes .env con la
# instalación principal.  Fija estas variables en Dokploy para el
# proyecto de desa.
# =============================================================================

# ── Postgres / auth ────────────────────────────────────────────────────────
DB_PASS_DESA=cambia_esto_desa
AUTH_PASS_DESA=cambia_esto_postgrest_desa
JWT_SECRET_DESA=cambia_esto_minimo_32_caracteres_desa_XXX
ADMIN_PASS_DESA=cambia_esto_desa_min_8

# ── Dominios servidos por Traefik ──────────────────────────────────────────
DOMINIO_WEB_DESA=desa.aprentix.es
DOMINIO_API_DESA=api.desa.aprentix.es

# ── SMTP (envío de emails de verificación / notificaciones) ────────────────
# Gmail:      smtp.gmail.com : 587 (STARTTLS) con contraseña de aplicación
# Zoho:       smtp.zoho.eu   : 587
# SendGrid:   smtp.sendgrid.net : 587  (SMTP_USER=apikey)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls
MAILER_TICK=30
MAILER_BATCH=25
MAILER_LOG=INFO

# ── Web Push (VAPID) — NUEVAS claves para DESA ─────────────────────────────
# Genera un par nuevo (NO reuses el de prod):
#   python notificador/gen_vapid.py
# La PUBLIC hay que meterla también en config('push_vapid_public') de
# la BBDD DESA para que la SPA la lea al suscribirse.
VAPID_PRIVATE_KEY_DESA=pega_aqui_la_pem_con_saltos_como_\n
VAPID_PUBLIC_KEY_DESA=pega_aqui_la_base64url
VAPID_SUBJECT_DESA=mailto:soporte@aprentix.es
NOTIF_TICK_DESA=300
NOTIF_BATCH_DESA=500
