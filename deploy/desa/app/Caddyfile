# Gateway público de desa.aprentix.es (contenedor único).  Sirve la
# nueva SPA de web/app/ como StaticFiles y proxy-a /api/ a PostgREST
# de DESA.  Traefik termina TLS y entrega HTTP en :80.

:80 {
    encode zstd gzip

    # ── API pública: /api/* → PostgREST del stack core-desa ──
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest-desa:3000
    }

    # ── Assets compartidos (una única copia física en /srv/shared) ──
    handle_path /shared/* {
        root * /srv/shared
        file_server
    }

    # ── App SPA (raíz) ──
    handle {
        root * /srv/app
        try_files {path} /index.html
        file_server
    }
}
