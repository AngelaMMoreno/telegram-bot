# Variables del stack PGADMIN (panel único para todas las ramas).
# Copiar a la Compose Application 'pgadmin' de Dokploy.
# Se despliega una sola vez en el servidor; gestiona las Postgres de todos
# los stacks `core` a través de sus alias de red (DB_ALIAS).

PGADMIN_EMAIL=tu@correo.es
PGADMIN_PASS=cambia_esto

# Host público del panel.
DOMINIO_PGADMIN=pgadmin.aprentix.es
