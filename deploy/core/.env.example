# Variables del stack CORE (db + postgrest).
# Mismos nombres en cualquier entorno; sólo cambia el valor.
#
# STACK_SUFFIX distingue despliegues coexistentes en el mismo Dokploy:
#   - Vacío en producción  → `db`, `postgrest`, router `aprentix-api`
#   - `-desa` en desa      → `db-desa`, `postgrest-desa`, router `aprentix-api-desa`

STACK_SUFFIX=-desa

DB_NAME=aprentix_desa
DB_PASS=cambia_esto
AUTH_PASS=cambia_esto_para_postgrest
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
ADMIN_PASS=cambia_esto_min_8

DOMINIO_API=api.desa.aprentix.es
