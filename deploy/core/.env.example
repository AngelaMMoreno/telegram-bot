# =============================================================================
# Variables del stack CORE (db + postgrest + pgadmin opcional).
#
# Mismos nombres que en producción.  Sólo cambia el valor.
# =============================================================================

# --- Distintivo del entorno (coexistencia prod + desa) ---
# Vacío  → containers `db`, `postgrest`, `pgadmin`, router `aprentix-api`
#          (compatible con lo que ya tienes desplegado en prod).
# `desa` → containers `db-desa`, `postgrest-desa`, router `aprentix-api-desa`.
DB_ALIAS=desa

# --- PostgreSQL ---
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=
AUTH_PASS=
ADMIN_PASS=

# --- Secreto HMAC para los JWT (mismo en Postgres y PostgREST).
# Mínimo 32 chars.  El MISMO valor que en el .env de app. ---
JWT_SECRET=

# --- Traefik ---
DOMINIO_API=api.desa.aprentix.es

# URL pública de la SPA usada en los correos de confirmación de cuenta.
DOMINIO_LANDING=desa.aprentix.es

# --- pgAdmin (SOLO se despliega si COMPOSE_PROFILES=pgadmin) ---
# En desa deja COMPOSE_PROFILES vacío: pgAdmin queda a cargo del
# stack CORE de producción, que ya tiene ambas entradas de servidor
# en `pgadmin/servers.json` (aprentix + aprentix-desa).
COMPOSE_PROFILES=
PGADMIN_EMAIL=cccoboss12@gmail.com
PGADMIN_PASS=
DOMINIO_PGADMIN=pgadmin.aprentix.es
