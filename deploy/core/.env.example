# Variables del stack CORE — VARIANTE DESA (entorno `desarrollo` de Dokploy).
# Copiar a la Compose Application `core` del entorno `desarrollo`.
#
# Recuerda: en esta rama el compose `deploy/core/docker-compose.yml` NO
# despliega `db` ni `pgadmin` (los aporta el `core` de producción, en la
# rama `main`). Aquí sólo hay `postgrest_desa` y `mailer_desa`, que se
# conectan al `db:5432` de producción por la red externa dokploy-network,
# apuntando a la BD `aprentix_desa`.

# ── Postgres (BD compartida con prod, DB distinta) ─────────────────────────
# Nombre de la BD de desarrollo. Debe existir ya en el mismo cluster
# Postgres que sirve `aprentix` (ver db/bootstrap_aprentix_desa.sql).
POSTGRES_DB=aprentix_desa
# El owner sigue siendo `aprentix` (rol global compartido con prod).
POSTGRES_USER=aprentix

# Contraseña del rol POSTGRES_USER — MISMA que la del stack core de prod
# (el rol es global; sólo hay una password real en el cluster).
DB_PASS=cambia_esto

# Contraseña del rol `autenticador` — MISMA que en prod (rol global).
AUTH_PASS=cambia_esto_para_postgrest

# ── JWT ─────────────────────────────────────────────────────────────────────
# EXACTAMENTE el mismo secreto que el core de producción. Postgres fija
# `app.jwt_secret` cluster-wide desde el `command` de su contenedor `db`,
# así que las sesiones de desa firmadas por PostgREST se validan contra
# el mismo secreto.
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios

# ── SMTP (mailer_desa) ─────────────────────────────────────────────────────
# Recomendado en desa: no enviar de verdad. MAILER_DEV_LOG_ONLY=1 imprime
# los correos en logs y no toca el SMTP externo.
MAILER_DEV_LOG_ONLY=1
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=hola@aprentix.es
SMTP_PASS=cambia_esto
SMTP_FROM=Aprentix DESA <hola@aprentix.es>
# starttls | ssl | off
SMTP_TLS=starttls

# ── Traefik (hosts propios de desa, no pisan los de prod) ──────────────────
# Debes tener el A record apuntando al VPS.
DOMINIO_API=api.desa.aprentix.es
