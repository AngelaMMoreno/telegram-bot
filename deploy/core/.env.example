# Variables del stack CORE (db + postgrest + embeddings + pgadmin + mailer).
# Copiar a la Compose Application 'core' de Dokploy.

# ── Postgres ────────────────────────────────────────────────────────────────
# Nombre y owner de la base de datos. Producción usa 'aprentix'. En la
# rama de rediseño se apunta a una BD limpia sobreescribiendo aquí:
#   POSTGRES_DB=aprentix_desa
#   POSTGRES_USER=aprentix_desa
# (owner distinto ⇒ evita cruces accidentales de credenciales en el mismo
# clúster). Si no defines nada, se usa 'aprentix' para mantener producción.
#POSTGRES_DB=aprentix
#POSTGRES_USER=aprentix

# Contraseña del rol POSTGRES_USER (el owner de la base de datos).
DB_PASS=cambia_esto

# Contraseña del rol 'autenticador' (el que usa PostgREST para conectarse).
AUTH_PASS=cambia_esto_para_postgrest

# ── JWT ─────────────────────────────────────────────────────────────────────
# Secreto HMAC HS256 con el que Postgres firma los tokens y PostgREST los
# verifica. Mínimo 32 caracteres. IMPORTANTE: idéntico al del stack 'teoria'.
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios

# ── Bootstrap ───────────────────────────────────────────────────────────────
# Contraseña inicial del usuario 'admin' de la aplicación. Se aplica al
# inicializar la BBDD por primera vez (base vacía). Mínimo 10 caracteres
# (política de contraseñas del bloque de auth).
ADMIN_PASS=cambia_esto_minimo_10

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=tu@correo.es
PGADMIN_PASS=cambia_esto

# ── SMTP (mailer) ──────────────────────────────────────────────────────────
# El servicio mailer envía verificación de email y reset de contraseña. En
# desarrollo puedes dejarlo con MAILER_DEV_LOG_ONLY=1 y los correos
# aparecerán impresos en los logs en vez de enviarse.
MAILER_DEV_LOG_ONLY=0
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=hola@aprentix.es
SMTP_PASS=cambia_esto
SMTP_FROM=Aprentix <hola@aprentix.es>
# starttls | ssl | off
SMTP_TLS=starttls

# ── Traefik ─────────────────────────────────────────────────────────────────
DOMINIO_API=api.aprentix.es
DOMINIO_PGADMIN=pgadmin.aprentix.es
