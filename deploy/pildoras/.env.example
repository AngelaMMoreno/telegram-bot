# Variables del stack PILDORAS (bot de Discord + ingesta).
# Copiar a la Compose Application 'pildoras' de Dokploy.
#
# No necesita DB_PASS ni JWT_SECRET: este stack no toca Postgres.

# ── Discord ─────────────────────────────────────────────────────────────────
# Portal de desarrolladores → tu aplicación → Bot → Reset Token.
# Es un secreto: da control total sobre el bot. Si se filtra, resetéalo.
DISCORD_TOKEN=cambia_esto

# ID del canal donde se publica la píldora diaria.
DISCORD_CANAL_ID=1541396299343990784

# Opcional pero recomendado: ID del servidor. Con él, los comandos aparecen
# al instante; sin él, el registro es global y Discord tarda hasta una hora.
DISCORD_GUILD_ID=1541394331519418519

# Hora de publicación (Europe/Madrid, 24h).
HORA_PILDORA=9
MINUTO_PILDORA=0

# ── Claude (solo lo necesita la ingesta) ────────────────────────────────────
ANTHROPIC_API_KEY=cambia_esto

# Longitud mínima de página para considerarla; sube si cuela mucha portada.
MIN_CHARS=400

# Tope de fragmentos por pasada. Ponlo en 20 para la primera prueba y
# vuelve a 0 (sin límite) cuando la calidad te convenza.
LIMITE=0
