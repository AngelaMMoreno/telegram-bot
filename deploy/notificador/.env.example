# =============================================================================
# Variables del stack NOTIFICADOR (worker Web Push).
# =============================================================================

DB_ALIAS=desa
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=

# Par VAPID.  Las MISMAS claves que en prod si quieres compartir las
# suscripciones ya emitidas; si generas un par nuevo, guarda también
# la pública en la BBDD (config.push_vapid_public).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:cccoboss12@gmail.com

TICK_SECONDS=300
BATCH_LIMIT=500
LOG_LEVEL=INFO

# --- Cron interno (encolado de avisos + tareas semanales) ---
# ENCOLAR_MINUTOS: cada cuánto llamamos a encolar_notificaciones_diarias()
#   Aparte del tick de envío. Por defecto 15 min.
# CRON_SEMANAL_HORA: hora UTC del lunes en que se ejecuta cron_semanal()
#   (recalcula métricas + ajusta carga para todos). Por defecto 3.
ENCOLAR_MINUTOS=15
CRON_SEMANAL_HORA=3
