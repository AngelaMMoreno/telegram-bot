# Variables del stack NOTIFICADOR (worker Web Push).

DB_NAME=aprentix_desa
DB_PASS=cambia_esto

# Par VAPID:
#   docker run --rm -v $PWD/notificador:/w -w /w python:3.12-slim \
#     sh -c 'pip install py-vapid && python gen_vapid.py'
# Y guarda también la pública en la BBDD:
#   UPDATE config SET valor = '"<clave_publica>"'::jsonb
#     WHERE clave = 'push_vapid_public';
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:soporte@aprentix.es

NOTIF_TICK=60
NOTIF_BATCH=50
NOTIF_LOG=INFO
