# Variables del stack NOTIFICADOR (worker Web Push).
# Copiar a la Compose Application 'notificador' de Dokploy.

# ── BBDD ────────────────────────────────────────────────────────────────────
# Mismos valores que en el stack core. Producción usa 'aprentix'; la rama
# de rediseño apunta a 'aprentix_desa'.
#POSTGRES_DB=aprentix
#POSTGRES_USER=aprentix
DB_PASS=cambia_esto

# ── VAPID (Web Push) ────────────────────────────────────────────────────────
# Genera el par con:  python notificador/gen_vapid.py
# La PUBLIC también debe guardarse en config.push_vapid_public (la SPA
# la lee por RPC push_config_publica); si no, la SPA se niega a suscribir.
#
# La PRIVATE puede ir en 3 formatos: PEM con \n literales (recomendado
# para .env), base64 del PEM entero, o PEM multilínea real. El worker
# autodetecta.
VAPID_PRIVATE_KEY=pega_aqui_la_pem_con_saltos_como_\n
VAPID_PUBLIC_KEY=pega_aqui_la_base64url
VAPID_SUBJECT=mailto:soporte@aprentix.es

# Cadencia del loop residente.
TICK_SECONDS=300
BATCH_LIMIT=500
LOG_LEVEL=INFO
