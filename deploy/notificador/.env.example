# =============================================================================
# Variables del stack NOTIFICADOR (worker Web Push).
# =============================================================================

DB_ALIAS=desa
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=

# Par VAPID.  Genera un par nuevo con:
#   docker run --rm -v $PWD/notificador:/w -w /w python:3.12-slim \
#     sh -c 'pip install py-vapid && python gen_vapid.py'
# Guarda la pública TAMBIÉN en la BBDD:
#   UPDATE config SET valor = '"<clave_publica>"'::jsonb
#     WHERE clave = 'push_vapid_public';
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:cccoboss12@gmail.com

TICK_SECONDS=300
BATCH_LIMIT=500
LOG_LEVEL=INFO
