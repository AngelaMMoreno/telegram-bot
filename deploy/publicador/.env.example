# Stack `publicador` — variables de entorno.
#
# Copia estos valores en Dokploy (Environment del Compose Application).
# Los de abajo son los del entorno DESARROLLO (rama `desa`); al final
# están las diferencias para producción.

# ── Repo de contenido ────────────────────────────────────────────────
# Si el repo es privado, mete un token de SÓLO LECTURA en la URL. No
# aparece en los logs: se tapa antes de imprimir nada.
CONTENIDO_REPO=https://x-access-token:ghp_xxxxxxxxxxxx@github.com/AngelaMMoreno/oposiciones.git

# Rama a publicar. En desarrollo, la rama de trabajo del contenido.
CONTENIDO_RAMA=desa

# ── Base de datos ────────────────────────────────────────────────────
# DESA usa `aprentix_desa`; producción usa `aprentix`. Las dos viven en
# el mismo cluster Postgres (hostname `db`) con el mismo rol y password.
PUBLICAR_DSN=postgres://aprentix:LA_MISMA_PASSWORD_QUE_DB_PASS@db:5432/aprentix_desa

# ── Qué y cuándo ─────────────────────────────────────────────────────
# Cinco campos cron. Cada 15 min es de sobra: una corrida sin cambios no
# toca la BBDD.
PUBLICAR_CRON=*/15 * * * *

# Vacío = todas las oposiciones del repo. Para acotar, lista separada por
# espacios: "auxilio-judicial gestion-procesal".
PUBLICAR_OPOSICIONES=

# ── Interruptor de seguridad ─────────────────────────────────────────
# VACÍO = sólo simulacros: enseña en los logs qué publicaría y no escribe.
# Déjalo así hasta que hayas visto un par de corridas y el plan te cuadre.
PUBLICAR_APLICAR=

# Corrida al arrancar además de la programada. Ponlo a 0 para desactivar.
PUBLICAR_AL_ARRANCAR=1

# ── Aviso por email ──────────────────────────────────────────────────
# MUY recomendable si no pasas el contenido por ningún CI: sin esto, un
# merge que rompa la plantilla para la publicación en silencio.
# Sólo avisa en los cambios de estado (empieza a fallar / se recupera).
AVISO_EMAIL=tu@correo.es

# Credenciales SMTP: las MISMAS del stack `mailer`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aprentix <hola@aprentix.es>
SMTP_TLS=starttls

TZ=Europe/Madrid

# ─────────────────────────────────────────────────────────────────────
# DIFERENCIAS EN PRODUCCIÓN (entorno `produccion`, rama `main`)
#
#   CONTENIDO_RAMA=main
#   PUBLICAR_DSN=postgres://aprentix:PASS@db:5432/aprentix
#
# Todo lo demás igual. Y en producción conviene un cron menos frecuente
# (p. ej. `0 * * * *`): el contenido llega ahí ya comprobado en desa.
