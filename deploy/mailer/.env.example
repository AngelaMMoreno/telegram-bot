# Variables del stack MAILER (worker SMTP).

STACK_SUFFIX=-desa

DB_NAME=aprentix_desa
DB_PASS=cambia_esto

# Con Gmail: contraseña de aplicación, no la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls

MAILER_TICK=30
MAILER_BATCH=25
MAILER_LOG=INFO
