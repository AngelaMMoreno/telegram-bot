# =============================================================================
# Variables del stack MAILER (worker SMTP).
# =============================================================================

DB_ALIAS=desa
POSTGRES_DB=aprentix_desa
POSTGRES_USER=aprentix
DB_PASS=

# --- SMTP para el mailer ---
MAILER_DEV_LOG_ONLY=0              # 1 → loguea el correo por stdout (no envía)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=angcar.morcob@gmail.com
SMTP_PASS=
SMTP_FROM=No Contestar <no-reply@aprentix.es>
SMTP_TLS=starttls

TICK_SECONDS=30
BATCH_LIMIT=25
LOG_LEVEL=INFO
